{
    "name": "@tenklo/docs-site",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare-content": "node scripts/prepare-content.mjs",
        "dev": "node scripts/dev.mjs",
        "prebuild": "npm run prepare-content",
        "build": "next build",
        "postbuild": "node scripts/postbuild.mjs",
        "start": "node .next/standalone/server.js",
        "smoke": "node scripts/smoke.mjs",
        "check:mdx": "npm run prepare-content && node scripts/check-mdx.mjs",
        "types:check": "npm run prepare-content && fumadocs-mdx && next typegen && tsc --noEmit"
    },
    "dependencies": {
        "fumadocs-core": "^16.17.8",
        "fumadocs-mdx": "^15.4.10",
        "fumadocs-openapi": "^12.5.5",
        "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.8",
        "lucide-react": "^1.62.0",
        "mdast-util-mdx-jsx": "^3.2.0",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "shiki": "^4.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "unist-util-visit": "^5.2.0"
    }
}
